{
  "name": "@swimhub-timer/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm exec dotenvx run -f .env.local -- expo start",
    "start:clear": "pnpm exec dotenvx run -f .env.local -- expo start --clear",
    "android": "pnpm exec dotenvx run -f .env.local -- expo run:android",
    "ios": "pnpm exec dotenvx run -f .env.local -- expo run:ios",
    "ios:dev-client": "pnpm exec dotenvx run -f .env.local -- expo start --ios --dev-client",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "ios:bump-build": "plutil -replace CFBundleVersion -string $(($(plutil -extract CFBundleVersion raw ios/SHTimer/Info.plist) + 1)) ios/SHTimer/Info.plist && plutil -extract CFBundleVersion raw ios/SHTimer/Info.plist",
    "build:ios:local": "pnpm ios:bump-build && eas build --platform ios --profile production --local"
  },
  "dependencies": {
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@ryuuhei0729/swimhub-oauth": "~0.1.2",
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/supabase-js": "^2.97.0",
    "@swimhub-timer/i18n": "*",
    "@swimhub-timer/shared": "*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "expo": "~55.0.26",
    "expo-apple-authentication": "~55.0.13",
    "expo-auth-session": "~55.0.16",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.35",
    "expo-file-system": "~55.0.22",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-media-library": "~55.0.17",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "ffmpeg-kit-react-native": "github:jdarshan5/ffmpeg-kit-react-native#rn-binaries",
    "i18next": "^24.0.0",
    "intl-pluralrules": "^2.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "react": "19.2.4",
    "react-i18next": "^15.0.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-google-mobile-ads": "^16.0.3",
    "react-native-mmkv": "^4.1.2",
    "react-native-purchases": "^9.12.0",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "^4.0.3",
    "react-native-worklets": "~0.8.1",
    "react-test-renderer": "^19.2.7",
    "zustand": "^5.0.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@types/react": "~19.1.0",
    "eslint": "^9",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
