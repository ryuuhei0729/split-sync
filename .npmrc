auto-install-peers=true
node-linker=hoisted
link-workspace-packages=true

# 3アプリ共通の OAuth 実装 (@ryuuhei0729/swimhub-oauth) は GitHub Packages で配布している。
# private パッケージなので読み取りにも認証が必要 (CI では NODE_AUTH_TOKEN シークレットを渡す)。
#
# 注意: `${NODE_AUTH_TOKEN}` が**未定義**だと pnpm はこの .npmrc を「その行だけ」ではなく
# **ファイル全体**を破棄する。上の node-linker=hoisted 等も一緒に失われるため、
# ローカルでトークン無しに `pnpm install` すると isolated linker の別物の node_modules ができる。
# (swim-hub では同じ構成で CI が全滅した。空文字列なら展開は成功する。)
# トークンを持たない環境で install する場合は `NODE_AUTH_TOKEN= pnpm install` のように
# 空で定義してから実行すること。
@ryuuhei0729:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
