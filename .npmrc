auto-install-peers=true
node-linker=hoisted
link-workspace-packages=true

# 3アプリ共通の OAuth 実装 (@ryuuhei0729/swimhub-oauth) は GitHub Packages で配布している。
# private パッケージなので読み取りにも認証が必要 (CI では NODE_AUTH_TOKEN シークレットを渡す)。
@ryuuhei0729:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
